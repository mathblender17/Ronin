GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional. Defaults to ./data/ronin.db
# RONIN_DATABASE_URL=sqlite:///./data/ronin.db

# Optional OpenRouter fallback. Only free models are ever called; see README "AI providers".
# OPENROUTER_API_KEY=your_openrouter_api_key
# RONIN_AI_PROVIDER_ORDER=gemini,openrouter
# RONIN_AI_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# RONIN_AI_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,xingchen-agi/xing4.0-29b-a4b:free
# RONIN_AI_TIMEOUT_SECONDS=45
# RONIN_AI_MAX_RETRIES=1
# RONIN_AI_MAX_OUTPUT_TOKENS=4096
# RONIN_AI_ALLOW_PAID_MODELS=false
